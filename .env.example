APP_ENV=development

# Local dev default (docker-compose Postgres).
# Supabase production example (see docs/deployment.md):
#   DATABASE_URL=postgresql://postgres.<proj-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# The postgresql:// / postgres:// scheme is normalized to postgresql+psycopg:// automatically.
DATABASE_URL=postgresql+psycopg://recoai:change_me_local_only@localhost:5432/recoai
POSTGRES_PASSWORD=change_me_local_only

# Comma-separated browser origins allowed to call the API (frontend deploy URL).
# Example: CORS_ORIGINS=https://reco-ai.vercel.app,https://reco-ai-git-main.vercel.app
CORS_ORIGINS=

# Optional: enables live Groq classification only when BOTH are set.
# Without them the app uses FakeExceptionClassifier (offline demo default).
GROQ_API_KEY=
GROQ_MODEL=

# Optional: webhook signature check fails closed when the secret is unset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
